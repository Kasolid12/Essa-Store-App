# ── Database ──────────────────────────────────────────────────────────
# Production: Neon PostgreSQL (shared with desktop app)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-ENDPOINT.aws.neon.tech/neondb?sslmode=require

# Local dev (uncomment below to use SQLite instead)
# DATABASE_URL=sqlite:///yazmina_web.db

# ── Auth ──────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE-ME-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=12

# ── App ───────────────────────────────────────────────────────────────
APP_NAME=Yazmina Hijab
APP_VERSION=0.1.0
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
