# ══════════════════════════════════════════════════════════════════════
# Yazmina Hijab Web — Backend Configuration
# Copy this file to .env and fill in the values.
# ══════════════════════════════════════════════════════════════════════

# ── Database (PostgreSQL / Neon) ──────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://username:password@ep-xxxx.region.aws.neon.tech/yazmina_hijab?sslmode=require

# ── Auth / JWT ────────────────────────────────────────────────────────
# IMPORTANT: Change this to a random 64-character string in production!
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=12

# ── App ───────────────────────────────────────────────────────────────
APP_NAME=Yazmina Hijab
APP_VERSION=0.1.0
DEBUG=false

# ── CORS (comma-separated origins) ───────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
